# Copy this file to .env and fill in the values. Restart `npm start` after editing.

# Groq (AI chatbot). Get a key at https://console.groq.com/
REACT_APP_GROQ_API_KEY=your_groq_api_key_here
# Optional: override the chat model (default: qwen/qwen3.8-27b)
# REACT_APP_GROQ_MODEL=openai/gpt-oss-120b

# EmailJS (contact form). Get these at https://dashboard.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=your_service_id_here
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id_here
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key_here
